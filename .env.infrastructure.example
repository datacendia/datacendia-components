# =============================================================================
# DATACENDIA INFRASTRUCTURE ENVIRONMENT VARIABLES
# =============================================================================
# Copy this to .env.infrastructure and update with your actual values

# Redis Configuration
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@localhost:6380
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_PASSWORD

# Apache Druid Configuration (optional)
DRUID_URL=http://localhost:8888
DRUID_BROKER_URL=http://localhost:8082

# ClickHouse Configuration
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=datacendia
CLICKHOUSE_PASSWORD=CHANGE_THIS_PASSWORD
CLICKHOUSE_DATABASE=datacendia

# Keycloak Configuration (optional)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=datacendia
KEYCLOAK_CLIENT_ID=datacendia-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_THIS_SECRET

# Apache Tika Configuration
TIKA_URL=http://localhost:9998

# Grafana Configuration
GRAFANA_URL=http://localhost:3100
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_PASSWORD

# Tempo Configuration (optional)
TEMPO_URL=http://localhost:3200
TEMPO_OTLP_GRPC=http://localhost:4317
TEMPO_OTLP_HTTP=http://localhost:4318

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090
