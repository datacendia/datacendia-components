# =============================================================================
# DATACENDIA PRODUCTION ENVIRONMENT - Enterprise Platinum
# =============================================================================
# Full production deployment - air-gapped sovereign stack
# ALL VALUES MUST BE CHANGED BEFORE DEPLOYMENT
#
# SECURITY CHECKLIST:
# [ ] Generate all secrets using: openssl rand -base64 64
# [ ] Configure SSL/TLS certificates
# [ ] Set up Keycloak realm and clients
# [ ] Configure backup and disaster recovery
# [ ] Enable audit logging
# [ ] Set up monitoring alerts
# =============================================================================

# Environment
NODE_ENV=production
PORT=3000

# Authentication - REQUIRE real login (mandatory in production)
REQUIRE_AUTH=true
DEMO_MODE=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Primary Database)
POSTGRES_USER=cendia_prod
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=datacendia_production
DATABASE_URL=postgresql://cendia_prod:GENERATE_SECURE_PASSWORD_HERE@postgres:5432/datacendia_production

# Redis (Cache + Queues)
REDIS_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
REDIS_URL=redis://:GENERATE_SECURE_PASSWORD_HERE@redis:6379

# Neo4j (Graph Database)
NEO4J_USER=neo4j
NEO4J_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
NEO4J_URI=bolt://neo4j:7687

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Authentication (generate with: openssl rand -base64 64)
JWT_SECRET=GENERATE_64_BYTE_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_64_BYTE_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_HERE
ENCRYPTION_ALGORITHM=aes-256-gcm

# CORS (update for your domain)
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# SSO / KEYCLOAK CONFIGURATION
# =============================================================================

KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://auth.your-domain.com
KEYCLOAK_REALM=datacendia
KEYCLOAK_CLIENT_ID=datacendia-app
KEYCLOAK_CLIENT_SECRET=GENERATE_SECRET_HERE
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_SECURE_PASSWORD_HERE

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

ENABLE_HTTPS=true
FORCE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/datacendia.crt
SSL_KEY_PATH=/etc/ssl/private/datacendia.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
GRAFANA_URL=https://monitoring.your-domain.com

# Prometheus
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

VITE_API_URL=https://api.your-domain.com/api/v1
VITE_WS_URL=wss://api.your-domain.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_SOVEREIGN_STACK=true
ENABLE_AIR_GAP_MODE=true
ENABLE_COUNCIL=true
ENABLE_CHRONOS=true
ENABLE_PULSE=true
ENABLE_COMPLIANCE=true
ENABLE_CRUCIBLE=true

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=datacendia-backups
BACKUP_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_HERE
