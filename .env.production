# =============================================================================
# DATACENDIA PRODUCTION ENVIRONMENT
# =============================================================================
# Full production deployment - air-gapped sovereign stack
# ALL VALUES MUST BE CHANGED BEFORE DEPLOYMENT

# =============================================================================
# CRITICAL: Generate all secrets before deployment!
# =============================================================================
# openssl rand -base64 64  (for JWT secrets)
# openssl rand -hex 32     (for encryption keys)
# =============================================================================

# PostgreSQL (Primary Database)
POSTGRES_USER=cendia_prod
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=datacendia_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis (Cache + Queues)
REDIS_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Neo4j (Graph Database)
NEO4J_USER=neo4j
NEO4J_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
NEO4J_URI=bolt://neo4j:7687

# JWT Authentication
JWT_SECRET=GENERATE_64_BYTE_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_64_BYTE_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_HERE
ENCRYPTION_ALGORITHM=aes-256-gcm

# Frontend URLs (update for your domain)
VITE_API_URL=https://api.your-domain.com/api/v1
VITE_WS_URL=wss://api.your-domain.com

# Keycloak SSO
KEYCLOAK_URL=https://auth.your-domain.com
KEYCLOAK_REALM=datacendia
KEYCLOAK_CLIENT_ID=datacendia-app
KEYCLOAK_CLIENT_SECRET=GENERATE_SECRET_HERE

# Monitoring
GRAFANA_ADMIN_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
PROMETHEUS_RETENTION=30d

# Security
NODE_ENV=production
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_HTTPS=true
FORCE_HTTPS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# Feature Flags
ENABLE_SOVEREIGN_STACK=true
ENABLE_AIR_GAP_MODE=true
