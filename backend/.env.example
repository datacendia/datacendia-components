# Server Configuration
NODE_ENV=development
PORT=3001

# PostgreSQL Database (using pgvector on port 5433)
DATABASE_URL=postgresql://postgres:P1e2r3u4*1967@localhost:5433/datacendia

# Redis - Use your existing Redis
REDIS_URL=redis://localhost:6379

# Neo4j Graph Database (runs on port 7687 via Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=datacendia_graph_2024

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# JWT Secrets (generate strong random strings in production)
JWT_SECRET=datacendia-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=datacendia-refresh-secret-change-in-production-2024
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info
