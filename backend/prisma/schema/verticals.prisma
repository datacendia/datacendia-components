enum TransferType {
  INBOUND
  OUTBOUND
  LOAN_OUT
  LOAN_IN
}

enum SportsDecisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  WITHDRAWN
}

enum ScoutingRecommendation {
  STRONG_BUY
  BUY
  CONDITIONAL
  PASS
}

