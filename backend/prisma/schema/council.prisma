// Council Domain - Agents, Deliberations, Decisions, Veto, Union, Dissent

// =============================================================================
// Prompt Versioning - Track every prompt template used in deliberations
// If a deliberation output is questioned 2 years later, you need to know
// exactly which prompt generated it.
// =============================================================================

model prompt_templates {
  id              String   @id @default(uuid())
  organization_id String?
  name            String
  category        String   // 'system' | 'agent' | 'mode' | 'custom'
  template        String   // The actual prompt text
  version         Int      @default(1)
  variables       Json     @default("[]") // List of {{variable}} placeholders
  model_config    Json     @default("{}") // temperature, top_p, etc.
  is_active       Boolean  @default(true)
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())
  parent_id       String?  // Previous version of this template

  usages          prompt_usages[]

  @@unique([name, version])
  @@index([category])
  @@index([name, is_active])
  @@index([organization_id])
}

model prompt_usages {
  id                String   @id @default(uuid())
  prompt_template_id String
  deliberation_id   String?
  agent_code        String?
  mode              String?
  input_variables   Json     @default("{}") // The actual values substituted
  model_used        String?
  token_count       Int?
  response_quality  Float?   // Optional quality score (0-1)
  created_at        DateTime @default(now())

  prompt_template   prompt_templates @relation(fields: [prompt_template_id], references: [id])

  @@index([prompt_template_id])
  @@index([deliberation_id])
  @@index([created_at])
}

model agent_query_responses {
  id              String          @id
  query_id        String
  agent_id        String
  analysis        String
  sources         Json            @default("[]")
  confidence      Float
  created_at      DateTime        @default(now())
  agents          agents          @relation(fields: [agent_id], references: [id])
  council_queries council_queries @relation(fields: [query_id], references: [id], onDelete: Cascade)
}

model agents {
  id                    String                  @id
  code                  String                  @unique
  name                  String
  role                  String
  description           String
  avatar_url            String?
  system_prompt         String
  capabilities          Json                    @default("[]")
  constraints           Json                    @default("[]")
  model_config          Json                    @default("{}")
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now())
  updated_at            DateTime
  agent_query_responses agent_query_responses[]
  deliberation_messages deliberation_messages[]
}

model council_queries {
  id                    String                  @id
  organization_id       String
  user_id               String
  query                 String
  context               Json                    @default("{}")
  status                QueryStatus             @default(PENDING)
  response              Json?
  confidence            Float?
  processing_time       Int?
  created_at            DateTime                @default(now())
  completed_at          DateTime?
  agent_query_responses agent_query_responses[]
  users                 users                   @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
}

model decision_activities {
  id          String    @id
  decision_id String
  actor       String
  action      String
  details     Json?
  timestamp   DateTime  @default(now())
  decisions   decisions @relation(fields: [decision_id], references: [id], onDelete: Cascade)
}

model decision_blockers {
  id                   String    @id
  decision_id          String
  type                 String
  name                 String
  reason               String
  blocked_since        DateTime
  estimated_resolution DateTime?
  escalation_level     Int       @default(0)
  resolved_at          DateTime?
  decisions            decisions @relation(fields: [decision_id], references: [id], onDelete: Cascade)
}

// REMOVED: model decision_dependencies (orphaned - not referenced in application code)

model decisions {
  id                                                                   String                  @id
  organization_id                                                      String
  user_id                                                              String
  title                                                                String
  description                                                          String
  category                                                             String?
  priority                                                             DecisionPriority        @default(MEDIUM)
  status                                                               DecisionStatus          @default(PENDING)
  department                                                           String?
  owner_name                                                           String?
  owner_email                                                          String?
  budget                                                               Float?
  timeframe                                                            String?
  deadline                                                             DateTime?
  estimated_daily_cost                                                 Float?
  total_cost_accrued                                                   Float?
  stakeholders                                                         String[]                @default([])
  deleted_at        DateTime?
  created_at                                                           DateTime                @default(now())
  updated_at                                                           DateTime
  resolved_at                                                          DateTime?
  decision_activities                                                  decision_activities[]
  decision_blockers                                                    decision_blockers[]
  // REMOVED: decision_dependencies (model not defined)
  // decision_dependencies_decision_dependencies_decision_idTodecisions
  // decision_dependencies_decision_dependencies_depends_on_idTodecisions
  executive_summaries                                                  executive_summaries[]

  @@index([organization_id])
  @@index([priority])
  @@index([status])
}

model deliberation_messages {
  id              String        @id
  deliberation_id String
  agent_id        String
  phase           String
  content         String
  target_agent_id String?
  sources         Json          @default("[]")
  confidence      Float?
  created_at      DateTime      @default(now())
  agents          agents        @relation(fields: [agent_id], references: [id])
  deliberations   deliberations @relation(fields: [deliberation_id], references: [id], onDelete: Cascade)

  @@index([deliberation_id, created_at])
}

model deliberations {
  id                    String                  @id
  organization_id       String
  question              String
  config                Json                    @default("{}")
  context               Json                    @default("{}")
  mode                  String?
  status                DeliberationStatus      @default(PENDING)
  current_phase         String?
  progress              Int                     @default(0)
  decision              Json?
  confidence            Float?
  started_at            DateTime?
  completed_at          DateTime?
  deleted_at            DateTime?
  created_at            DateTime                @default(now())
  approvals             approvals[]
  deliberation_messages deliberation_messages[]
  deliberation_votes    deliberation_votes[]
  organizations         organizations           @relation(fields: [organization_id], references: [id])
  executive_summaries   executive_summaries[]
  decision_outcomes     decision_outcomes[]

  @@index([organization_id, status])
}

model decision_packets {
  id                    String    @id @default(uuid())
  run_id                String    @unique
  version               Int       @default(1)
  organization_id       String
  session_id            String
  user_id               String?
  deliberation_id       String?
  question              String
  context               String?
  recommendation        String
  confidence            Decimal   @db.Decimal(5, 4)
  confidence_bounds     Json      @default("{}")
  key_assumptions       Json      @default("[]")
  thresholds            Json      @default("{}")
  conditions_for_change Json      @default("[]")
  citations             Json      @default("[]")
  agent_contributions   Json      @default("[]")
  dissents              Json      @default("[]")
  consensus_reached     Boolean   @default(false)
  tool_calls            Json      @default("[]")
  approvals             Json      @default("[]")
  policy_gates          Json      @default("[]")
  artifact_hashes       Json      @default("{}")
  merkle_root           String
  signature             Json?
  signed_at             DateTime?
  regulatory_frameworks Json      @default("[]")
  retention_until       DateTime
  duration_ms           Int?
  created_at            DateTime  @default(now())
  completed_at          DateTime?
  exported_at           DateTime?

  @@index([organization_id])
  @@index([session_id])
  @@index([deliberation_id])
  @@index([run_id])
}

model executive_summaries {
  id              String         @id
  organization_id String
  deliberation_id String?
  decision_id     String?
  type            SummaryType
  title           String
  content         String
  key_points      Json           @default("[]")
  action_items    Json           @default("[]")
  participants    Json           @default("[]")
  risks           Json           @default("[]")
  recommendations Json           @default("[]")
  next_steps      Json           @default("[]")
  language        String         @default("en")
  generated_by    String
  created_at      DateTime       @default(now())
  updated_at      DateTime
  decisions       decisions?     @relation(fields: [decision_id], references: [id])
  deliberations   deliberations? @relation(fields: [deliberation_id], references: [id])

  @@index([organization_id])
  @@index([type])
}

model deliberation_votes {
  id              String   @id @default(uuid())
  deliberation_id String
  agent_role      String
  vote            String // approve, reject, abstain
  reasoning       String?
  confidence      Float?
  created_at      DateTime @default(now())

  deliberations deliberations @relation(fields: [deliberation_id], references: [id], onDelete: Cascade)

  @@index([deliberation_id])
}

