enum DecisionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionStatus {
  PENDING
  BLOCKED
  DEFERRED
  ESCALATED
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum DeliberationStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum QueryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SummaryType {
  COUNCIL_DELIBERATION
  DECISION_DNS
  PRE_MORTEM
  GHOST_BOARD
  DECISION_DEBT
  REGULATORY_ABSORB
  LIVE_DEMO
}
