  target_id       String
  reason          String
  severity        String
  created_at      DateTime   @default(now())
  // REMOVED: veto_rules relation (model was removed as orphan)
  // rule            veto_rules @relation(fields: [rule_id], references: [id])

  @@index([organization_id])
}

