// Mesh Domain - Network Nodes, Connections, Channels, AR, Blackbox

// REMOVED: model mesh_nodes (orphaned — not referenced in application code)

// REMOVED: model mesh_connections (orphaned — not referenced in application code)

// REMOVED: model secure_channels (orphaned — not referenced in application code)

model blackbox_units {
  id                String         @id @default(uuid())
  organization_id   String
  serial_number     String         @unique
  name              String
  status            BlackboxStatus @default(OPERATIONAL)
  location          Json           @default("{}")
  specifications    Json           @default("{}")
  health_metrics    Json           @default("{}")
  last_sync         DateTime       @default(now())
  last_verification DateTime       @default(now())
  created_at        DateTime       @default(now())

  backup_jobs    backup_jobs[]
  stored_records stored_records[]
  recoveries     recovery_procedures[]
  reports        integrity_reports[]

  @@index([organization_id])
  @@index([status])
}

// REMOVED: model backup_jobs (orphaned — not referenced in application code)

// REMOVED: model ar_devices (orphaned — not referenced in application code)

// REMOVED: model ar_overlays (orphaned — not referenced in application code)

// REMOVED: model ar_sessions (orphaned — not referenced in application code)

model mesh_network_stats {
  id                 String   @id @default(uuid())
  recorded_at        DateTime @default(now())
  total_participants Int      @default(0)
  active_today       Int      @default(0)
  data_points_shared BigInt   @default(0)
  insights_generated Int      @default(0)
  avg_response_ms    Int      @default(0)
  privacy_score      Float    @default(99.9)
  uptime_percent     Float    @default(99.99)

  @@index([recorded_at])
}

model mesh_participants {
  id                 String   @id @default(uuid())
  anonymous_id       String   @unique
  industry           String
  region             String
  employee_range     String
  revenue_range      String
  contribution_score Float    @default(0)
  data_quality       Float    @default(0)
  last_active        DateTime @default(now())
  joined_at          DateTime @default(now())

  @@index([industry])
}

model mesh_benchmarks {
  id            String   @id @default(uuid())
  name          String
  category      String
  industry      String
  p25_value     Float
  p50_value     Float
  p75_value     Float
  p90_value     Float
  trend         String   @default("stable")
  trend_percent Float    @default(0)
  unit          String
  participants  Int      @default(0)
  updated_at    DateTime @default(now())

  @@unique([name, industry])
  @@index([category])
}

model mesh_risk_signals {
  id                  String   @id @default(uuid())
  title               String
  description         String
  category            String
  severity            String
  affected_industries String[] @default([])
  affected_regions    String[] @default([])
  confidence          Float    @default(0)
  sources             Int      @default(0)
  recommendations     Json     @default("[]")
  detected_at         DateTime @default(now())
  valid_until         DateTime

  @@index([severity])
}

enum MeshNodeType {
  DCU
  GATEWAY
  ENDPOINT
  SENSOR
}

enum NodeStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
}

enum EncryptionLevel {
  STANDARD
  HIGH
  QUANTUM_RESISTANT
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  DEGRADED
}

enum ChannelProtocol {
  AES256
  CHACHA20
  KYBER
  DILITHIUM
}

enum ChannelStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BlackboxStatus {
  OPERATIONAL
  DEGRADED
  OFFLINE
  RECOVERY_MODE
}

enum BackupSourceType {
  LEDGER
  CHRONOS
  WITNESS
  CUSTOM
}

enum BackupStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

enum BackupPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum ARDeviceType {
  VISION_PRO
  META_QUEST
  HOLOLENS
  CUSTOM
}

enum ARDeviceStatus {
  ACTIVE
  INACTIVE
  PAIRING
  MAINTENANCE
}

enum SecurityClearance {
  BASIC
  STANDARD
  ELEVATED
  EXECUTIVE
}

enum OverlayType {
  HEALTH_SCORE
  RISK_INDICATOR
  COUNCIL_INSIGHT
  METRIC
  ALERT
  CUSTOM
}

enum SessionType {
  INDIVIDUAL
  COLLABORATIVE
  PRESENTATION
}

enum SessionStatus {
  ACTIVE
  PAUSED
  ENDED
}
