generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_query_responses {
  id              String          @id
  query_id        String
  agent_id        String
  analysis        String
  sources         Json            @default("[]")
  confidence      Float
  created_at      DateTime        @default(now())
  agents          agents          @relation(fields: [agent_id], references: [id])
  council_queries council_queries @relation(fields: [query_id], references: [id], onDelete: Cascade)
}

model agents {
  id                    String                  @id
  code                  String                  @unique
  name                  String
  role                  String
  description           String
  avatar_url            String?
  system_prompt         String
  capabilities          Json                    @default("[]")
  constraints           Json                    @default("[]")
  model_config          Json                    @default("{}")
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now())
  updated_at            DateTime
  agent_query_responses agent_query_responses[]
  deliberation_messages deliberation_messages[]
}

model alerts {
  id                 String              @id
  organization_id    String
  metric_id          String?
  severity           AlertSeverity
  status             AlertStatus         @default(ACTIVE)
  title              String
  message            String
  source             String
  metadata           Json                @default("{}")
  acknowledged_at    DateTime?
  acknowledged_by    String?
  resolved_at        DateTime?
  resolved_by        String?
  resolution         String?
  created_at         DateTime            @default(now())
  metric_definitions metric_definitions? @relation(fields: [metric_id], references: [id])
  organizations      organizations       @relation(fields: [organization_id], references: [id])

  @@index([organization_id, status])
  @@index([severity])
}

model api_keys {
  id              String        @id
  organization_id String
  user_id         String
  name            String
  key_hash        String
  key_prefix      String
  scopes          Json          @default("[]")
  last_used_at    DateTime?
  expires_at      DateTime?
  created_at      DateTime      @default(now())
  revoked_at      DateTime?
  organizations   organizations @relation(fields: [organization_id], references: [id])
  users           users         @relation(fields: [user_id], references: [id])
}

model approvals {
  id                  String              @id
  organization_id     String
  type                ApprovalType
  reference_id        String
  requester_id        String
  title               String
  description         String?
  status              ApprovalStatus      @default(PENDING)
  reviewer_id         String?
  reviewed_at         DateTime?
  comments            String?
  created_at          DateTime            @default(now())
  workflow_executions workflow_executions @relation(fields: [reference_id], references: [id], map: "approval_execution_fkey")
  deliberations       deliberations       @relation(fields: [reference_id], references: [id])
  users               users               @relation(fields: [requester_id], references: [id])

  @@index([organization_id, status])
}

model audit_logs {
  id              String        @id
  organization_id String
  user_id         String?
  action          String
  resource_type   String
  resource_id     String?
  details         Json          @default("{}")
  ip_address      String?
  user_agent      String?
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id])
  users           users?        @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([organization_id, created_at])
  @@index([resource_type, resource_id])
}

model chain_of_thought_logs {
  id              String   @id
  organization_id String?
  session_id      String
  agent_id        String
  query           String
  steps           Json
  final_answer    String
  confidence      Float?
  model           String
  tokens_used     Int
  latency_ms      Int
  created_at      DateTime @default(now())

  @@index([agent_id])
  @@index([organization_id])
  @@index([session_id])
}

model council_queries {
  id                    String                  @id
  organization_id       String
  user_id               String
  query                 String
  context               Json                    @default("{}")
  status                QueryStatus             @default(PENDING)
  response              Json?
  confidence            Float?
  processing_time       Int?
  created_at            DateTime                @default(now())
  completed_at          DateTime?
  agent_query_responses agent_query_responses[]
  users                 users                   @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
}

model data_sources {
  id               String           @id
  organization_id  String
  name             String
  type             DataSourceType
  config           Json             @default("{}")
  credentials      Json             @default("{}")
  status           DataSourceStatus @default(PENDING)
  last_sync_at     DateTime?
  last_sync_status String?
  sync_schedule    String?
  metadata         Json             @default("{}")
  created_at       DateTime         @default(now())
  updated_at       DateTime
  organizations    organizations    @relation(fields: [organization_id], references: [id])

  @@index([organization_id, type])
}

model decision_activities {
  id          String    @id
  decision_id String
  actor       String
  action      String
  details     Json?
  timestamp   DateTime  @default(now())
  decisions   decisions @relation(fields: [decision_id], references: [id], onDelete: Cascade)
}

model decision_blockers {
  id                   String    @id
  decision_id          String
  type                 String
  name                 String
  reason               String
  blocked_since        DateTime
  estimated_resolution DateTime?
  escalation_level     Int       @default(0)
  resolved_at          DateTime?
  decisions            decisions @relation(fields: [decision_id], references: [id], onDelete: Cascade)
}

model decision_dependencies {
  id                                                       String    @id
  decision_id                                              String
  depends_on_id                                            String
  created_at                                               DateTime  @default(now())
  decisions_decision_dependencies_decision_idTodecisions   decisions @relation("decision_dependencies_decision_idTodecisions", fields: [decision_id], references: [id], onDelete: Cascade)
  decisions_decision_dependencies_depends_on_idTodecisions decisions @relation("decision_dependencies_depends_on_idTodecisions", fields: [depends_on_id], references: [id], onDelete: Cascade)

  @@unique([decision_id, depends_on_id])
}

model decisions {
  id                                                                   String                  @id
  organization_id                                                      String
  user_id                                                              String
  title                                                                String
  description                                                          String
  category                                                             String?
  priority                                                             DecisionPriority        @default(MEDIUM)
  status                                                               DecisionStatus          @default(PENDING)
  department                                                           String?
  owner_name                                                           String?
  owner_email                                                          String?
  budget                                                               Float?
  timeframe                                                            String?
  deadline                                                             DateTime?
  estimated_daily_cost                                                 Float?
  total_cost_accrued                                                   Float?
  stakeholders                                                         String[]                @default([])
  created_at                                                           DateTime                @default(now())
  updated_at                                                           DateTime
  resolved_at                                                          DateTime?
  decision_activities                                                  decision_activities[]
  decision_blockers                                                    decision_blockers[]
  decision_dependencies_decision_dependencies_decision_idTodecisions   decision_dependencies[] @relation("decision_dependencies_decision_idTodecisions")
  decision_dependencies_decision_dependencies_depends_on_idTodecisions decision_dependencies[] @relation("decision_dependencies_depends_on_idTodecisions")
  executive_summaries                                                  executive_summaries[]

  @@index([organization_id])
  @@index([priority])
  @@index([status])
}

model deliberation_messages {
  id              String        @id
  deliberation_id String
  agent_id        String
  phase           String
  content         String
  target_agent_id String?
  sources         Json          @default("[]")
  confidence      Float?
  created_at      DateTime      @default(now())
  agents          agents        @relation(fields: [agent_id], references: [id])
  deliberations   deliberations @relation(fields: [deliberation_id], references: [id], onDelete: Cascade)

  @@index([deliberation_id, created_at])
}

model deliberations {
  id                    String                  @id
  organization_id       String
  question              String
  config                Json                    @default("{}")
  context               Json                    @default("{}")
  mode                  String?
  status                DeliberationStatus      @default(PENDING)
  current_phase         String?
  progress              Int                     @default(0)
  decision              Json?
  confidence            Float?
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime                @default(now())
  approvals             approvals[]
  deliberation_messages deliberation_messages[]
  deliberation_votes    deliberation_votes[]
  organizations         organizations           @relation(fields: [organization_id], references: [id])
  executive_summaries   executive_summaries[]
  decision_outcomes     decision_outcomes[]

  @@index([organization_id, status])
}

model demo_requests {
  id                String   @id
  first_name        String
  last_name         String
  email             String
  company           String
  job_title         String
  company_size      String
  industry          String
  primary_interest  String
  additional_notes  String?
  marketing_consent Boolean  @default(false)
  status            String   @default("new")
  created_at        DateTime @default(now())
}

model email_verifications {
  id         String   @id
  user_id    String   @unique
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at])
  @@index([token])
}

model embeddings {
  id              String   @id
  organization_id String?
  source_type     String
  source_id       String
  content         String
  content_hash    String   @unique
  embedding       Bytes
  embedding_model String   @default("nomic-embed-text")
  dimensions      Int      @default(768)
  metadata        Json     @default("{}")
  created_at      DateTime @default(now())

  @@index([organization_id])
  @@index([source_id])
  @@index([source_type])
}

model execution_nodes {
  id                  String              @id
  execution_id        String
  node_id             String
  status              ExecutionStatus     @default(PENDING)
  input               Json                @default("{}")
  output              Json                @default("{}")
  error               String?
  duration            Int?
  started_at          DateTime?
  completed_at        DateTime?
  workflow_executions workflow_executions @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@unique([execution_id, node_id])
}

model executive_summaries {
  id              String         @id
  organization_id String
  deliberation_id String?
  decision_id     String?
  type            SummaryType
  title           String
  content         String
  key_points      Json           @default("[]")
  action_items    Json           @default("[]")
  participants    Json           @default("[]")
  risks           Json           @default("[]")
  recommendations Json           @default("[]")
  next_steps      Json           @default("[]")
  language        String         @default("en")
  generated_by    String
  created_at      DateTime       @default(now())
  updated_at      DateTime
  decisions       decisions?     @relation(fields: [decision_id], references: [id])
  deliberations   deliberations? @relation(fields: [deliberation_id], references: [id])

  @@index([organization_id])
  @@index([type])
}

model forecasts {
  id                 String         @id
  organization_id    String
  name               String
  target_metric      String
  horizon            Json
  model              String
  features           Json           @default("[]")
  status             ForecastStatus @default(PENDING)
  predictions        Json?
  accuracy           Json?
  feature_importance Json?
  created_at         DateTime       @default(now())
  completed_at       DateTime?
  scenarios          scenarios[]

  @@index([organization_id])
}

model health_scores {
  id              String   @id
  organization_id String
  overall         Int
  data_score      Int
  ops_score       Int
  security_score  Int
  people_score    Int
  calculated_at   DateTime
  details         Json     @default("{}")

  @@index([organization_id, calculated_at])
}

model llm_cache {
  id               String   @id
  query_hash       String   @unique
  model            String
  prompt           String
  system_prompt    String?
  response         String
  tokens_in        Int
  tokens_out       Int
  latency_ms       Int
  temperature      Float    @default(0.7)
  hit_count        Int      @default(1)
  last_accessed_at DateTime @default(now())
  expires_at       DateTime
  created_at       DateTime @default(now())

  @@index([expires_at])
  @@index([model])
}

model metric_definitions {
  id               String          @id
  organization_id  String
  name             String
  code             String
  description      String?
  formula          Json
  unit             String?
  category         String?
  thresholds       Json            @default("{}")
  owner_id         String?
  refresh_schedule String?
  created_at       DateTime        @default(now())
  updated_at       DateTime
  alerts           alerts[]
  organizations    organizations   @relation(fields: [organization_id], references: [id])
  users            users?          @relation(fields: [owner_id], references: [id])
  metric_values    metric_values[]

  @@unique([organization_id, code])
}

model metric_values {
  id                 String             @id
  metric_id          String
  value              Float
  dimensions         Json               @default("{}")
  timestamp          DateTime
  created_at         DateTime           @default(now())
  metric_definitions metric_definitions @relation(fields: [metric_id], references: [id], onDelete: Cascade)

  @@index([metric_id, timestamp])
}

model organizations {
  id                 String               @id
  name               String
  slug               String               @unique
  industry           String?
  company_size       String?
  settings           Json                 @default("{}")
  created_at         DateTime             @default(now())
  updated_at         DateTime
  deleted_at         DateTime?
  alerts             alerts[]
  api_keys           api_keys[]
  audit_logs         audit_logs[]
  data_sources       data_sources[]
  deliberations      deliberations[]
  metric_definitions metric_definitions[]
  teams              teams[]
  users              users[]
  workflows          workflows[]
  crucible_simulations crucible_simulations[]
  
  // Panopticon - Regulation Engine
  panopticon_regulations panopticon_regulations[]
  panopticon_violations  panopticon_violations[]
  panopticon_forecasts   panopticon_forecasts[]
  
  // Aegis - Defense Intelligence
  aegis_signals          aegis_signals[]
  aegis_threats          aegis_threats[]
  aegis_briefings        aegis_briefings[]
  
  // Eternal - Long Horizon Archive
  eternal_artifacts      eternal_artifacts[]
  eternal_migrations     eternal_migrations[]
  eternal_succession     eternal_succession[]
  
  // Symbiont - Ecosystem Engine
  symbiont_entities      symbiont_entities[]
  symbiont_opportunities symbiont_opportunities[]
  symbiont_relationships symbiont_relationships[]
  
  // Vox - Stakeholder Voice
  vox_stakeholders       vox_stakeholders[]
  vox_impacts            vox_impacts[]
  vox_votes              vox_votes[]
  vox_assemblies         vox_assemblies[]
  
  // Crown Jewels - Echo, RedTeam, Gnosis
  decision_outcomes      decision_outcomes[]
}

// Deliberation Votes for Echo tracking
model deliberation_votes {
  id              String        @id @default(uuid())
  deliberation_id String
  agent_role      String
  vote            String        // approve, reject, abstain
  reasoning       String?
  confidence      Float?
  created_at      DateTime      @default(now())
  
  deliberations   deliberations @relation(fields: [deliberation_id], references: [id], onDelete: Cascade)
  
  @@index([deliberation_id])
}

model password_resets {
  id         String    @id
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([token])
  @@index([user_id])
}

model query_classifications {
  id              String   @id
  organization_id String?
  user_id         String?
  query           String
  query_hash      String
  classification  String
  confidence      Float
  routed_model    String
  actual_model    String?
  was_correct     Boolean?
  latency_ms      Int?
  metadata        Json     @default("{}")
  created_at      DateTime @default(now())

  @@index([classification])
  @@index([organization_id])
  @@index([routed_model])
}

model scenarios {
  id          String     @id
  forecast_id String?
  name        String
  assumptions Json       @default("[]")
  projections Json?
  created_at  DateTime   @default(now())
  forecasts   forecasts? @relation(fields: [forecast_id], references: [id])
}

model sessions {
  id                 String   @id
  user_id            String
  refresh_token_hash String
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  created_at         DateTime @default(now())
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id])
}

model team_members {
  team_id    String
  user_id    String
  role       String   @default("member")
  created_at DateTime @default(now())
  teams      teams    @relation(fields: [team_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([team_id, user_id])
}

model teams {
  id              String         @id
  organization_id String
  name            String
  description     String?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  team_members    team_members[]
  organizations   organizations  @relation(fields: [organization_id], references: [id])
}

model translations {
  id         String   @id
  key        String
  language   String
  namespace  String   @default("common")
  value      String
  context    String?
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime

  @@unique([key, language, namespace])
  @@index([language])
  @@index([namespace])
}

model user_language_preferences {
  id            String   @id
  user_id       String   @unique
  language      String   @default("en")
  date_format   String   @default("MM/DD/YYYY")
  time_format   String   @default("12h")
  timezone      String   @default("UTC")
  number_format String   @default("en-US")
  created_at    DateTime @default(now())
  updated_at    DateTime
}

model users {
  id                 String               @id
  organization_id    String
  email              String               @unique
  password_hash      String?
  name               String
  avatar_url         String?
  role               UserRole             @default(VIEWER)
  status             UserStatus           @default(ACTIVE)
  email_verified     Boolean              @default(false)
  email_verified_at  DateTime?
  preferences        Json                 @default("{}")
  last_login_at      DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime
  deleted_at         DateTime?
  api_keys           api_keys[]
  approvals          approvals[]
  audit_logs         audit_logs[]
  council_queries    council_queries[]
  metric_definitions metric_definitions[]
  sessions           sessions[]
  team_members       team_members[]
  organizations      organizations        @relation(fields: [organization_id], references: [id])
  crucible_simulations crucible_simulations[]
  eternal_artifacts    eternal_artifacts[]

  @@index([email])
  @@index([organization_id])
}

model workflow_executions {
  id              String            @id
  workflow_id     String
  status          ExecutionStatus   @default(PENDING)
  parameters      Json              @default("{}")
  current_node    String?
  progress        Int               @default(0)
  outputs         Json              @default("{}")
  error           String?
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime          @default(now())
  approvals       approvals[]
  execution_nodes execution_nodes[]
  workflows       workflows         @relation(fields: [workflow_id], references: [id])

  @@index([workflow_id, status])
}

model workflows {
  id                  String                @id
  organization_id     String
  name                String
  description         String?
  category            String?
  trigger             Json
  definition          Json
  status              WorkflowStatus        @default(DRAFT)
  created_at          DateTime              @default(now())
  updated_at          DateTime
  workflow_executions workflow_executions[]
  organizations       organizations         @relation(fields: [organization_id], references: [id])

  @@index([organization_id, status])
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalType {
  WORKFLOW
  DELIBERATION
  ACCESS
  BUDGET
  DATA_EXPORT
}

enum DataSourceStatus {
  PENDING
  CONNECTED
  SYNCING
  ERROR
  DISABLED
}

enum DataSourceType {
  POSTGRESQL
  MYSQL
  SNOWFLAKE
  BIGQUERY
  SALESFORCE
  SAP
  ORACLE
  MONGODB
  REST_API
  GRAPHQL
  CSV_UPLOAD
  AWS
  AZURE
  HUBSPOT
  GOOGLE_SHEETS
  AIRTABLE
  STRIPE
  SHOPIFY
  ZENDESK
  JIRA
  SLACK
  REDIS
  NEO4J
}

enum DecisionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionStatus {
  PENDING
  BLOCKED
  DEFERRED
  ESCALATED
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum DeliberationStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  AWAITING_APPROVAL
}

enum ForecastStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SummaryType {
  COUNCIL_DELIBERATION
  DECISION_DNS
  PRE_MORTEM
  GHOST_BOARD
  DECISION_DEBT
  REGULATORY_ABSORB
  LIVE_DEMO
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// =============================================================================
// CENDIA CRUCIBLE™ - Synthetic Multiverse Simulation Engine
// =============================================================================

model crucible_simulations {
  id                    String                    @id
  organization_id       String
  name                  String
  description           String?
  simulation_type       CrucibleSimulationType
  status                CrucibleSimulationStatus  @default(DRAFT)
  config                Json                      // Simulation parameters
  digital_twin_snapshot Json?                     // Enterprise state at start
  scenario_definition   Json                      // What-if scenarios
  monte_carlo_runs      Int                       @default(1000)
  confidence_level      Float                     @default(0.95)
  time_horizon_days     Int                       @default(365)
  created_by            String
  created_at            DateTime                  @default(now())
  updated_at            DateTime
  started_at            DateTime?
  completed_at          DateTime?
  results_summary       Json?
  
  organizations         organizations             @relation(fields: [organization_id], references: [id])
  users                 users                     @relation(fields: [created_by], references: [id])
  universes             crucible_universes[]
  impacts               crucible_impacts[]
  council_deliberations crucible_council_deliberations[]
  
  @@index([organization_id, status])
  @@index([simulation_type])
}

model crucible_universes {
  id                String                   @id
  simulation_id     String
  universe_number   Int                      // Branch number in multiverse
  parent_universe   String?                  // Parent branch (null = root)
  branch_point      String?                  // Decision that caused branch
  probability       Float                    // Statistical likelihood
  state_snapshot    Json                     // Enterprise state in this universe
  kpi_projections   Json                     // Projected KPIs
  risk_scores       Json                     // Risk assessment
  outcome_summary   String?
  outcome_sentiment CrucibleOutcomeSentiment @default(NEUTRAL)
  created_at        DateTime                 @default(now())
  
  simulation        crucible_simulations     @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  failure_cascades  crucible_failure_cascades[]
  
  @@unique([simulation_id, universe_number])
  @@index([simulation_id])
}

model crucible_impacts {
  id                String                @id
  simulation_id     String
  impact_category   CrucibleImpactCategory
  entity_type       String                // department, system, person, kpi, etc.
  entity_id         String?
  entity_name       String
  baseline_value    Float?
  projected_value   Float?
  change_percent    Float?
  confidence        Float                 @default(0.95)
  severity          CrucibleSeverity      @default(LOW)
  description       String?
  propagation_path  Json?                 // How the impact spreads
  created_at        DateTime              @default(now())
  
  simulation        crucible_simulations  @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  
