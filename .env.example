# ============================================
# HEALTHCARE - FHIR
# ============================================
FHIR_BASE_URL=
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_SCOPES=
FHIR_EHR_VENDOR=

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_TEMP_DIR=./data/backup/temp
BACKUP_WEBHOOK_URL=
PG_DUMP_PATH=pg_dump

# ============================================
# SOVEREIGN MESH STORAGE
# ============================================
MESH_STORAGE_PATH=./data/mesh
PORTABLE_STORAGE_PATH=./data/portable
DIODE_ARCHIVE_PATH=./data/diode/archive
DIODE_QUARANTINE_PATH=./data/diode/quarantine
DIODE_REJECT_PATH=./data/diode/reject
TIMELOCK_STORAGE_PATH=./data/timelock
REPLAY_STORAGE_PATH=./data/replay
DNA_EXPORT_PATH=./data/dna-exports
RLHF_DATA_PATH=./data/rlhf
RLHF_TRAINING_THRESHOLD=100

# ============================================
# SPECIALIZED AI MODELS
# ============================================
APOTHEOSIS_MODEL=
BIAS_MODEL=
CRUCIBLE_MODEL=
GHOSTBOARD_MODEL=
PREMORTEM_MODEL=
OMNITRANSLATE_MODEL=
OMNITRANSLATE_FAST_MODEL=
OMNITRANSLATE_FALLBACK_MODEL=

# ============================================
# DEPLOYMENT
# ============================================
DEPLOYMENT_MODE=standalone
ENVIRONMENT_NAME=production
SERVICE_VERSION=1.0.0
FRONTEND_URL=https://app.datacendia.com
API_BASE_URL=https://api.datacendia.com
API_URL=https://api.datacendia.com
CORS_ORIGINS=https://app.datacendia.com
REQUIRE_AUTH=true
DISABLE_CSRF=false
DEMO_MODE=false
DATACENDIA_LICENSE_TIER=enterprise
HOSTNAME=
RUNNER_IDENTITY=
GIT_COMMIT_SHA=
GIT_BRANCH=
GIT_TAG=

# ============================================
# SETTINGS ENCRYPTION
# ============================================
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY
NEXUS_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY
SECRET=CHANGE_ME_SECURE_SECRET
