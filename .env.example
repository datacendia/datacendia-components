# ============================================
# DATACENDIA PLATFORM - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Default values match docker-compose.unified.yml

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ============================================
# DATABASE - PostgreSQL
# ============================================
POSTGRES_USER=datacendia
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=datacendia
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public

# ============================================
# CACHE - Redis
# ============================================
REDIS_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380

# ============================================
# GRAPH DATABASE - Neo4j
# ============================================
NEO4J_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# ============================================
# AUTHENTICATION - JWT
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_64_CHAR_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_SECURE_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# ENCRYPTION
# ============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# ============================================
# AI / LLM
# ============================================
# Ollama (Local) - default
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# OpenAI (Cloud) - optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://app.datacendia.com
TRUSTED_PROXIES=nginx

# ============================================
# EMAIL (Choose one provider)
# ============================================
# SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@datacendia.com

# Or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@datacendia.com

# ============================================
# BILLING - Stripe
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=
DATADOG_API_KEY=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_DEMO_MODE=false
ENABLE_OLLAMA=true
ENABLE_OPENAI=false
ENABLE_BILLING=false

# ============================================
# FRONTEND BUILD ARGS
# ============================================
VITE_API_URL=https://api.datacendia.com/api/v1
VITE_WS_URL=wss://api.datacendia.com
VITE_APP_NAME=Datacendia
VITE_APP_VERSION=1.0.0

# Stripe (frontend) - Publishable key + Price IDs from Stripe Dashboard
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_FOUNDATION_ANNUAL=
VITE_STRIPE_PRICE_FOUNDATION_3YR=
VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=
VITE_STRIPE_PRICE_ENTERPRISE_3YR=
VITE_STRIPE_PRICE_STRATEGIC_ANNUAL=
VITE_STRIPE_PRICE_STRATEGIC_3YR=

# =============================================================================
# EXTENDED CONFIGURATION (A++ Readiness)
# =============================================================================

# ============================================
# AI PROVIDERS (Additional)
# ============================================
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# NVIDIA NIM
NIM_API_KEY=
NIM_BASE_URL=http://localhost:8000
NIM_MODEL_NAME=meta/llama-3.1-8b-instruct
NIM_EMBED_URL=
NIM_EMBED_MODEL=

# NVIDIA Triton
TRITON_BASE_URL=
TRITON_MODEL_NAME=
TRITON_EMBED_MODEL=

# Ollama Model Zoo
OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=llama3.2:latest
OLLAMA_MODEL_LARGE=llama3.1:70b
OLLAMA_MODEL_FLAGSHIP=llama3.1:70b
OLLAMA_MODEL_REASONING=deepseek-r1:14b
OLLAMA_MODEL_CODER=qwen2.5-coder:14b
OLLAMA_MODEL_VISION=llava:13b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI additional
OPENAI_API_BASE=
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview

# Embedding
EMBEDDING_MODEL=nomic-embed-text

# Inference Provider selection
INFERENCE_PROVIDER=ollama
INFERENCE_FAILOVER=true

# ============================================
# IMMUTABLE AUDIT LEDGER
# ============================================
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_KEY=CHANGE_ME_64_HEX_CHAR_SIGNING_KEY

# ============================================
# PRESIDIO - ML-based PII Detection
# ============================================
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002

# ============================================
# DOCUMENT PROCESSING
# ============================================
TIKA_URL=http://localhost:9998

# ============================================
# VECTOR DATABASE
# ============================================
QDRANT_URL=http://localhost:6333

# ============================================
# OBJECT STORAGE - MinIO
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# ============================================
# ANALYTICS - ClickHouse
# ============================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=datacendia

# ============================================
# ANALYTICS - Apache Druid
# ============================================
DRUID_BROKER_URL=http://localhost:8082
DRUID_COORDINATOR_URL=http://localhost:8081
DRUID_ROUTER_URL=http://localhost:8888

# ============================================
# STREAMING - Kafka
# ============================================
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=datacendia
KAFKA_SSL_ENABLED=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ============================================
# STREAMING - Apache Flink
# ============================================
FLINK_ENABLED=false
FLINK_URL=http://localhost:8081
FLINK_MODE=standalone

# ============================================
# WORKFLOW ORCHESTRATION
# ============================================
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=datacendia
TEMPORAL_TASK_QUEUE=datacendia-tasks

# ============================================
# KEY MANAGEMENT (KMS)
# ============================================
KMS_PROVIDER=local
LOCAL_KEY_PATH=./keys

# Azure Key Vault
AZURE_KEYVAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_NAME=

# AWS KMS
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_ENDPOINT=

# HashiCorp Vault / OpenBao
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT_PATH=secret
VAULT_KEY_NAME=datacendia-key
OPENBAO_ADDR=
OPENBAO_ENABLED=false
OPENBAO_TOKEN=
OPENBAO_NAMESPACE=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=

# ============================================
# SSO / IDENTITY PROVIDERS
# ============================================
# Keycloak
KEYCLOAK_URL=
KEYCLOAK_REALM=datacendia
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# SAML
SAML_ENTITY_ID=
SAML_ACS_URL=

# OIDC
OIDC_REDIRECT_URI=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_PAT=
GITHUB_ORG=

# ============================================
# MFA (Multi-Factor Authentication)
# ============================================
MFA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY
SESSION_SECRET=CHANGE_ME_SECURE_SESSION_SECRET

# ============================================
# COMPLIANCE & EVIDENCE
# ============================================
COMPLIANCE_SIGNING_KEY=
ECHO_SIGNING_KEY=
GATEWAY_SIGNING_KEY=
EVIDENCE_LEDGER_PATH=./data/evidence/ledger
EVIDENCE_EXPORT_PATH=./data/evidence/exports
EVIDENCE_REPORTS_PATH=./data/evidence/reports
PDF_STORAGE_PATH=./data/pdfs

# ============================================
# SECURITY - ClamAV (Antivirus)
# ============================================
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ============================================
# SECURITY - Hardware / TPM
# ============================================
TPM_DEVICE_PATH=
TPM_STORAGE_PATH=./data/tpm
CANARY_STORAGE_PATH=./data/canary

# ============================================
# SECURITY - Confidential Computing
# ============================================
CC_ENABLED=false
CC_REQUIRE_GPU=false
CC_EVIDENCE_DIR=./data/cc-evidence
CC_ATTESTATION_URL=

# ============================================
# NOTIFICATIONS
# ============================================
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
TEAMS_WEBHOOK_URL=
TEAMS_REDIRECT_URI=

# ============================================
# OBSERVABILITY - OpenTelemetry
# ============================================
TRACING_ENABLED=false
OTEL_SERVICE_NAME=datacendia-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9464

# ============================================
# GUARDRAILS - NVIDIA NeMo
# ============================================
NEMO_GUARDRAILS_ENABLED=false
NEMO_GUARDRAILS_URL=http://localhost:8080
NEMO_GUARDRAILS_MODE=server

# ============================================
# POLICY ENGINE - Open Policy Agent
# ============================================
OPA_ENABLED=false
OPA_URL=http://localhost:8181
OPA_MODE=http

# ============================================
# FEATURE FLAGS - Unleash
# ============================================
UNLEASH_URL=
UNLEASH_API_TOKEN=

# ============================================
# GPU ACCELERATION - NVIDIA RAPIDS
# ============================================
RAPIDS_ENABLED=false
RAPIDS_URL=
RAPIDS_GPU_DEVICE=0

# ============================================
