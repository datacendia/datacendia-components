{
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "dashboard"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/*.d.ts",
    "!src/**/index.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 2.5,
  "disableTypeChecks": true,
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "dashboard": {
    "project": "datacendia/datacendia-components",
    "version": "main",
    "module": "frontend"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".stryker-tmp",
    "playwright-report"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "BlockStatement"
    ]
  }
}
