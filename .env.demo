# =============================================================================
# DATACENDIA DEMO ENVIRONMENT
# =============================================================================
# Pre-configured for demonstrations with sample data
# Requires real login but uses demo credentials

# Environment
NODE_ENV=production
PORT=3000

# Authentication - REQUIRE real login (no devAuth bypass)
REQUIRE_AUTH=true
DEMO_MODE=true

# Database (Docker container)
DATABASE_URL=postgresql://cendia:cendia_sovereign_2025@localhost:5434/datacendia

# Redis
REDIS_URL=redis://localhost:6380

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demo_graph_2024

# JWT Secrets (demo - change for each client demo!)
JWT_SECRET=demo-jwt-secret-datacendia-2024-enterprise-platinum
JWT_REFRESH_SECRET=demo-refresh-secret-datacendia-2024-enterprise

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Demo Credentials (seeded in database)
# Email: admin@datacendia.com
# Password: DatacendiaAdmin2024!

# Disable dangerous features in demo
DISABLE_DATA_DELETE=true
DISABLE_USER_CREATE=true
DISABLE_CONFIG_CHANGE=true
