# =============================================================================
# DATACENDIA DEMO ENVIRONMENT
# =============================================================================
# Pre-configured for demonstrations with sample data
# Safe to show clients - uses demo credentials

# Docker Compose passwords (demo)
POSTGRES_PASSWORD=demo_datacendia_2024
REDIS_PASSWORD=demo_redis_2024
NEO4J_PASSWORD=demo_graph_2024

# JWT Secrets (demo - not for production!)
JWT_SECRET=demo-jwt-secret-datacendia-2024
JWT_REFRESH_SECRET=demo-refresh-secret-datacendia-2024

# Frontend (commented out to use Vite proxy in dev)
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_WS_URL=ws://localhost:3000

# Demo Mode Settings
DEMO_MODE=true
DEMO_ORGANIZATION=Acme Corporation
DEMO_USER_EMAIL=demo@datacendia.com
DEMO_USER_PASSWORD=DemoUser2024!

# Disable dangerous features in demo
DISABLE_DATA_DELETE=true
DISABLE_USER_CREATE=true
DISABLE_CONFIG_CHANGE=true
