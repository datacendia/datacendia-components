# =============================================================================
# DATACENDIA PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Use this configuration for production deployments

# Environment
NODE_ENV=production

# Server
PORT=3001
HOST=0.0.0.0

# Database (use production database URL)
DATABASE_URL=postgresql://cendia:CHANGE_THIS_PASSWORD@your-db-host:5432/datacendia

# Redis (deployed infrastructure)
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@your-redis-host:6380

# Neo4j (deployed infrastructure)
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_PASSWORD

# ClickHouse (deployed infrastructure)
CLICKHOUSE_URL=http://your-clickhouse-host:8123
CLICKHOUSE_USER=datacendia
CLICKHOUSE_PASSWORD=CHANGE_THIS_PASSWORD

# Security
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING_MINIMUM_64_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_VERY_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_EXPIRATION=1h
REFRESH_TOKEN_EXPIRATION=7d

# CORS (update with your production domain)
CORS_ORIGINS=https://datacendia.yourcompany.com,https://app.yourcompany.com

# Rate Limiting (stricter in production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Features
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false

# Ollama (LLM service)
OLLAMA_HOST=http://your-ollama-host:11434
OLLAMA_TIMEOUT=60000

# MinIO (Evidence Vault)
MINIO_ENDPOINT=your-minio-host
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_THIS
MINIO_SECRET_KEY=CHANGE_THIS
MINIO_USE_SSL=true

# KMS (Key Management)
KMS_PROVIDER=aws-kms
AWS_KMS_KEY_ID=your-kms-key-id
AWS_REGION=us-east-1

# Monitoring
PROMETHEUS_URL=http://your-prometheus-host:9090
GRAFANA_URL=http://your-grafana-host:3100

# Email (for notifications)
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=notifications@yourcompany.com
SMTP_PASSWORD=CHANGE_THIS
SMTP_FROM=Datacendia <notifications@yourcompany.com>

# Session
SESSION_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# Performance
MAX_REQUEST_SIZE=10mb
COMPRESSION_ENABLED=true
PRISMA_CONNECTION_POOL_SIZE=20

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# IMPORTANT: Change all passwords and secrets before deploying to production!
# =============================================================================
