# =============================================================================
# DATACENDIA PILOT ENVIRONMENT - Enterprise Platinum
# =============================================================================
# For pilot customers with real data but limited scale
# Requires proper credentials from client
#
# SETUP CHECKLIST:
# [ ] Generate unique JWT secrets for this pilot
# [ ] Configure client's database credentials
# [ ] Set pilot organization ID and expiry date
# [ ] Configure feature flags based on pilot scope
# =============================================================================

# Environment
NODE_ENV=production
PORT=3000

# Authentication - REQUIRE real login
REQUIRE_AUTH=true
DEMO_MODE=false

# =============================================================================
# DATABASE CONFIGURATION (set by client)
# =============================================================================

DATABASE_URL=postgresql://pilot_user:CHANGE_ME_pilot_password@localhost:5432/datacendia_pilot
REDIS_URL=redis://:CHANGE_ME_pilot_redis@localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_pilot_graph

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT Secrets (generate new ones for each pilot!)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_new_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_new_refresh_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://pilot.client-domain.com,http://localhost:5173

# =============================================================================
# PILOT CONFIGURATION
# =============================================================================

PILOT_MODE=true
PILOT_ORGANIZATION_ID=
PILOT_ORGANIZATION_NAME=
PILOT_MAX_USERS=25
PILOT_MAX_DATA_SOURCES=10
PILOT_EXPIRY_DATE=2025-06-30

# =============================================================================
# FEATURE FLAGS (customize per pilot)
# =============================================================================

ENABLE_COUNCIL=true
ENABLE_CHRONOS=true
ENABLE_PULSE=true
ENABLE_COMPLIANCE=true
ENABLE_CRUCIBLE=false
ENABLE_SOVEREIGN_STACK=false

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
