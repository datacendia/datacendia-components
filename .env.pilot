# =============================================================================
# DATACENDIA PILOT ENVIRONMENT
# =============================================================================
# For pilot customers with real data but limited scale
# Requires proper credentials from client

# Docker Compose passwords (set by client)
POSTGRES_PASSWORD=CHANGE_ME_pilot_password
REDIS_PASSWORD=CHANGE_ME_pilot_redis
NEO4J_PASSWORD=CHANGE_ME_pilot_graph

# JWT Secrets (generate new ones for each pilot!)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_new_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_new_refresh_secret

# Frontend
# VITE_API_URL=https://pilot.client-domain.com/api/v1
# VITE_WS_URL=wss://pilot.client-domain.com

# Pilot Settings
PILOT_MODE=true
PILOT_ORGANIZATION_ID=
PILOT_MAX_USERS=25
PILOT_MAX_DATA_SOURCES=10
PILOT_EXPIRY_DATE=

# Features enabled in pilot
ENABLE_COUNCIL=true
ENABLE_CHRONOS=true
ENABLE_PULSE=true
ENABLE_COMPLIANCE=true
ENABLE_SOVEREIGN=false
